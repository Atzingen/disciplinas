# Copie para .env (que não entra no repositório) e preencha.

# Client ID OAuth do tipo "Aplicativo da Web", do Google Cloud Console. É um valor público.
GOOGLE_CLIENT_ID=000000000000-exemplo.apps.googleusercontent.com

# Contas Google que administram todas as turmas, separadas por vírgula.
PROFESSORES=professor@ifsp.edu.br

# Origens das páginas que podem chamar o serviço, separadas por vírgula.
ORIGENS_PERMITIDAS=https://atzingen.github.io,http://localhost:8000

# Pasta do servidor com o banco e os arquivos entregues, fora do clone do repositório.
PASTA_DADOS_NO_SERVIDOR=/var/local/apps/disciplinas-dados

# Usuário e grupo (uid:gid) donos da pasta de dados.
USUARIO_DO_SERVICO=1000:1000
